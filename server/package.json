{
  "name": "brevly-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/infra/http/server.ts",
    "build": "tsup src/infra/http/server.ts --format esm --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "pretest": "npm run db:migrate:test",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^5.2.6",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^4.0.2",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
